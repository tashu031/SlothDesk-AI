# SlothDesk AI Environment Configuration
# Copy to .env to customize local settings

# Local Ollama service URL
OLLAMA_BASE_URL=http://localhost:11434

# Open-weight model tag (e.g. gemma2:2b, gemma:2b, llama3.2:3b)
SLOTHDESK_MODEL=gemma2:2b

# SQLite Database storage location
SLOTHDESK_DB_PATH=slothdesk.db

# Heuristic time-saved estimate in seconds per file organized
SECONDS_SAVED_PER_FILE=45

# Maximum file scan bound for directory traversal
MAX_SCAN_FILES=500

# Content preview size bounds (bytes and max LLM context chars)
MAX_PREVIEW_BYTES=4096
MAX_LLM_CONTENT_CHARS=1500
